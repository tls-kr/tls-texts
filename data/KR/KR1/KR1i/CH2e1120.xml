<head xml:id="CH2e1120_CHANT_001-1a.1-h-h"><seg xml:id="CH2e1120_CHANT_001-1a.1-h">樂書</seg></head>
            <p><seg xml:id="CH2e1120_CHANT_001-1a.1"/><seg xml:id="CH2e1120_CHANT_001-1a.2">雅樂部器<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.3">隨律定聲<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.4">各得其所也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.5">黃鍾之均則用黃鍾之器合<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.6">太蔟之均則用太蔟之器<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.7">是故旋官法此<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.8">聲律克諧<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.9">則無錯器<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.10">度音咸取中聲協律<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.11">是以三倍黃鍾而大至于雷霆<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.12">謂黃鍾之律度三分<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.13">寸而倍<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.14">成一尺八寸<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.15">則合雷霆之濁聲也<c n="；"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.16">九寸而減<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.17">餘四寸五分<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.18">則應中宮之清聲也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.19">唯九寸是謂正聲<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.20">而可協和神人<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.21">感通天地<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.22">流而不息<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.23">合同而化<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.24">是故地氣上隮<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.25">天氣下降<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.26">陰陽相摩<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.27">天地相蕩<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.28">鼓之以雷霆<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.29">奮之以風雨<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.30">動之以四時<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.31">煖之以日月<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.32">而百化興焉<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.33">如此則樂者天地之和也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.34">故<c n="《"/>書<c n="》"/>云<c n="："/></seg><seg xml:id="CH2e1120_CHANT_001-1a.35">聲依永<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.36">律和聲<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.37">則五音不失其常<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.38">六律不差其度<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.39">謂孤竹之管<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.40">律應夾鍾<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.41">聲與氣諧<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.42">故感天神而降<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.43">孫竹之管<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.44">律應林鍾<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.45">聲與氣諧<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.46">故感地祗而出<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.47">陰竹之管<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.48">律應黃鍾<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.49">聲與氣諧<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.50">故感人鬼而至<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-1a.51"><c n="《"/>太平御覽<c n="》"/>卷五百六十五<c n="。"/></seg></p>
            <p><seg xml:id="CH2e1120_CHANT_001-2a.1"/><seg xml:id="CH2e1120_CHANT_001-2a.2">謹案<c n="："/></seg><seg xml:id="CH2e1120_CHANT_001-2a.3"><c n="《"/>禮記疏<c n="》"/>云<c n="："/></seg><seg xml:id="CH2e1120_CHANT_001-2a.4"><c n="「"/>伏羲樂日<c n="《"/>立基<c n="》"/><c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.5">言伏羲之代五運成立<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.6">甲子始基<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.7">畫八卦以定陰陽<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.8">造琴瑟以諧律呂<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.9">繼德之樂<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.10">故曰<c n="《"/>立基<c n="》"/>也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.11">神農樂曰<c n="《"/>下謀<c n="》"/><c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.12">言神農播種百穀<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.13">濟育群生<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.14">造五絃之琴<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.15">演六十四卦<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.16">承基立化<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.17">設降神謀<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.18">故樂曰<c n="《"/>下謀<c n="》"/><c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.19">以明功也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.20">黃帝樂曰<c n="《"/>雲門<c n="》"/><c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.21">言黃帝之道成名百物<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.22">明民共財<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.23">德如雲出其門<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.24">民可有於族類<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.25">故樂曰<c n="《"/>雲門<c n="》"/><c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-2a.26"><c n="《"/>太平御覽<c n="》"/>卷五百六十六<c n="。"/></seg></p>
            <p><seg xml:id="CH2e1120_CHANT_001-3a.1"/><seg xml:id="CH2e1120_CHANT_001-3a.2">錞于者<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-3a.3">以銅為之<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-3a.4">其銅象鍾<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-3a.5">頂大復挈口弇<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-3a.6">上以伏獸為鼻<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-3a.7">內懸子銅鈴舌<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-3a.8">凡作樂<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-3a.9">振而鳴之<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-3a.10">與鼓相和<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-3a.11"><c n="《"/>太平御覽<c n="》"/>卷五百七十五<c n="。"/></seg></p>
            <p><seg xml:id="CH2e1120_CHANT_001-4a.1"/><seg xml:id="CH2e1120_CHANT_001-4a.2">凡金為樂器有六<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.3">皆鍾之類也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.4">曰鍾<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.5">曰鎛<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.6">曰錞<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.7">曰鐲<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.8">曰鐃<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.9">曰鐸<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.10">鎛如鍾而大<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.11">錞<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.12">錞于也<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.13">圓如椎<c n="；"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.14">頭<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.15">上大下小者<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.16">謂<c n="「"/>金錞和鼓<c n="」"/><c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.17">鐲<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.18">鉦也<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.19">形如小鍾<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.20">軍行為鼓節<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.21">鐃<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.22">如鈴而無舌<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.23">有柄而執之<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.24">鐸如大鈴<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-4a.25">同上<c n="。"/></seg></p>
            <p><seg xml:id="CH2e1120_CHANT_001-5a.1"/><seg xml:id="CH2e1120_CHANT_001-5a.2">筑者<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-5a.3">形如頌琴<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-5a.4">施十三絃<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-5a.5">頂細<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-5a.6">肩圓<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-5a.7">品聲按柱<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-5a.8">鼓法以左手扼之<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-5a.9">右手以竹擊之<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-5a.10">隨調應律<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-5a.11"><c n="《"/>太平御覽<c n="》"/>卷五百七十六<c n="。"/></seg></p>
            <p><seg xml:id="CH2e1120_CHANT_001-6a.1"/><seg xml:id="CH2e1120_CHANT_001-6a.2">笛者<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.3">滌也<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.4">丘仲所作<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.5">可以滌蕩邪氣<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.6">出揚政聲<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.7">是故列和善吹<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.8">裁十二之音應律<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.9">荀勗樞問<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.10">依三尺二調成均<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.11">翦雲夢之霜筠<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.12">法龍吟之異韻<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.13">三孔為籥<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.14">文舞執之<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.15">邠人吹也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.16">五孔為篴<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.17">祴樂<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.18">樂師掌之<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.19">六孔為笛<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.20">羌人吹之<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.21">七孔為調<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.22">漢部用也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.23">今之七星<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.24">古之長笛<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.25">一定為調<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.26">合鍾磬之均<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.27">各有短長<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.28">應律之度<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-6a.29"><c n="《"/>太平御覽<c n="》"/>卷五百八十<c n="。"/></seg></p>
            <p><seg xml:id="CH2e1120_CHANT_001-7a.1"/><seg xml:id="CH2e1120_CHANT_001-7a.2">壎者<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-7a.3">喧也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-7a.4">周平王時<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-7a.5">暴辛公燒土為之<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-7a.6"><c n="《"/>太平御覽<c n="》"/>卷五百八十一<c n="。"/></seg></p>
            <p><seg xml:id="CH2e1120_CHANT_001-7a.7">雷鞉者<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-7a.8"><c n="《"/>周禮<c n="》"/><c n="「"/>瞽矇掌播鞉<c n="」"/><c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-7a.9">鞉如鼓而小<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-7a.10">以木貫之作柄<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-7a.11">柄各四枚<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-7a.12">為八面也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-7a.13">旁以羯皮為耳<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-7a.14">搖之還自擊<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-7a.15">禮書曰<c n="："/></seg><seg xml:id="CH2e1120_CHANT_001-7a.16"><c n="「"/>掌之人左手播鞉<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-7a.17">右手擊鼓<c n="」"/>之是也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-7a.18"><c n="《"/>太平御覽<c n="》"/>卷八十二<c n="。"/></seg></p>
            <p><seg xml:id="CH2e1120_CHANT_001-8a.1"/><seg xml:id="CH2e1120_CHANT_001-8a.2">聖人作椌楬<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-8a.3">壎篪則所起矣<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-8a.4">柷<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-8a.5">眾也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-8a.6">立夏之音<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-8a.7">萬物眾形皆成也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-8a.8">方面各二尺<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-8a.9">傍開員孔<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-8a.10">內手於孔擊之<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-8a.11">以舉眾樂也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-8a.12">同上<c n="。"/></seg></p>
            <p><seg xml:id="CH2e1120_CHANT_001-9a.1"/><seg xml:id="CH2e1120_CHANT_001-9a.2">木鐸者<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-9a.3">鈴也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-9a.4">生銅為之<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-9a.5">以木作舌<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-9a.6">故天將以夫子為木鐸<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-9a.7">言施政教時<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-9a.8">天將命以號令天下<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-9a.9">文舞所執而鳴之<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-9a.10">以振文教<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-9a.11"><c n="《"/>太平御覽<c n="》"/>卷五八十四<c n="。"/></seg></p>
            <p><seg xml:id="CH2e1120_CHANT_001-10a.1"/><seg xml:id="CH2e1120_CHANT_001-10a.2">金鐸者<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.3">形同木鐸<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.4">以金為舌<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.5">號令為度<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.6">鳴而驚眾<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.7">武舞所執<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.8">以振武教者也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.9">同上<c n="。"/></seg></p>
            <p><seg xml:id="CH2e1120_CHANT_001-10a.10">金鐃<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.11">小者似鈴<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.12">執而鳴之<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.13">以止鼓也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.14">武舞<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.15">工人所執<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.16">謂振而退武也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.17">大者<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.18">懸而擊之<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.19">象鍾形<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.20">薄旁有二十四銑<c n="，"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.21">應律音而和樂也<c n="。"/></seg><seg xml:id="CH2e1120_CHANT_001-10a.22">同上<c n="。"/></seg></p>
         </div>
      </body>
   </text>
