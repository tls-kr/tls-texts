<head xml:id="CH8x3011_CHANT_004-1a.1-h-h"><seg xml:id="CH8x3011_CHANT_004-1a.1-h">肩眽</seg></head>
            <p><seg xml:id="CH8x3011_CHANT_004-1a.1"/><seg xml:id="CH8x3011_CHANT_004-1a.2"/><seg xml:id="CH8x3011_CHANT_004-1a.3">肩眽<c n="："/></seg><seg xml:id="CH8x3011_CHANT_004-1a.4"/><seg xml:id="CH8x3011_CHANT_004-1a.5">起於耳後<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.6"/><seg xml:id="CH8x3011_CHANT_004-1a.7">下肩<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.8"/><seg xml:id="CH8x3011_CHANT_004-1a.9">出臑外廉</seg><seg xml:id="CH8x3011_CHANT_004-1a.10"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.11"/><seg xml:id="CH8x3011_CHANT_004-1a.12">出臂外</seg><seg xml:id="CH8x3011_CHANT_004-1a.13"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.14"/><seg xml:id="CH8x3011_CHANT_004-1a.15">腕上</seg><seg xml:id="CH8x3011_CHANT_004-1a.16"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.17"/><seg xml:id="CH8x3011_CHANT_004-1a.18">乘手北<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.19"/><seg xml:id="CH8x3011_CHANT_004-1a.20">是動則病</seg><seg xml:id="CH8x3011_CHANT_004-1a.21"><c n="："/></seg><seg xml:id="CH8x3011_CHANT_004-1a.22"/><seg xml:id="CH8x3011_CHANT_004-1a.23">嗌痛</seg><seg xml:id="CH8x3011_CHANT_004-1a.24"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.25"/><seg xml:id="CH8x3011_CHANT_004-1a.26">頷穜</seg><seg xml:id="CH8x3011_CHANT_004-1a.27"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.28"/><seg xml:id="CH8x3011_CHANT_004-1a.29">不可以顧<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.30"/><seg xml:id="CH8x3011_CHANT_004-1a.31">肩</seg><seg xml:id="CH8x3011_CHANT_004-1a.32"/><seg xml:id="CH8x3011_CHANT_004-1a.33">以脫<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.34"/><seg xml:id="CH8x3011_CHANT_004-1a.35">臑以折<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.36"/><seg xml:id="CH8x3011_CHANT_004-1a.37">是肩眽主治<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.38"/><seg xml:id="CH8x3011_CHANT_004-1a.39">其所產病</seg><seg xml:id="CH8x3011_CHANT_004-1a.40"><c n="："/></seg><seg xml:id="CH8x3011_CHANT_004-1a.41"/><seg xml:id="CH8x3011_CHANT_004-1a.42">領痛</seg><seg xml:id="CH8x3011_CHANT_004-1a.43"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.44"/><seg xml:id="CH8x3011_CHANT_004-1a.45">喉痹</seg><seg xml:id="CH8x3011_CHANT_004-1a.46"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.47"/><seg xml:id="CH8x3011_CHANT_004-1a.48">臂痛</seg><seg xml:id="CH8x3011_CHANT_004-1a.49"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.50"/><seg xml:id="CH8x3011_CHANT_004-1a.51">肘</seg><seg xml:id="CH8x3011_CHANT_004-1a.52">痛<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.53"/><seg xml:id="CH8x3011_CHANT_004-1a.54">為四病<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_004-1a.55"/></p>
         </div>
         <div>
                
<head xml:id="CH8x3011_CHANT_005-1a.1-h-h"><seg xml:id="CH8x3011_CHANT_005-1a.1-h">耳眽</seg></head>
            <p><seg xml:id="CH8x3011_CHANT_005-1a.1"/><seg xml:id="CH8x3011_CHANT_005-1a.2"/><seg xml:id="CH8x3011_CHANT_005-1a.3">耳眽<c n="："/></seg><seg xml:id="CH8x3011_CHANT_005-1a.4"/><seg xml:id="CH8x3011_CHANT_005-1a.5">起於手北<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_005-1a.6"/><seg xml:id="CH8x3011_CHANT_005-1a.7">出臂外兩骨之間<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_005-1a.8"/><seg xml:id="CH8x3011_CHANT_005-1a.9">上骨</seg><seg xml:id="CH8x3011_CHANT_005-1a.10">下廉<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_005-1a.11"/><seg xml:id="CH8x3011_CHANT_005-1a.12">出肘中</seg><seg xml:id="CH8x3011_CHANT_005-1a.13"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_005-1a.14"/><seg xml:id="CH8x3011_CHANT_005-1a.15">入耳中<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_005-1a.16"/><seg xml:id="CH8x3011_CHANT_005-1a.17">是動則病<c n="："/></seg><seg xml:id="CH8x3011_CHANT_005-1a.18"/><seg xml:id="CH8x3011_CHANT_005-1a.19">耳聾</seg><seg xml:id="CH8x3011_CHANT_005-1a.20"/><seg xml:id="CH8x3011_CHANT_005-1a.21">煇煇朜朜<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_005-1a.22"/><seg xml:id="CH8x3011_CHANT_005-1a.23">嗌穜<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_005-1a.24"/><seg xml:id="CH8x3011_CHANT_005-1a.25">是耳眽主治<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_005-1a.26"/><seg xml:id="CH8x3011_CHANT_005-1a.27">其所產病<c n="："/></seg><seg xml:id="CH8x3011_CHANT_005-1a.28"/><seg xml:id="CH8x3011_CHANT_005-1a.29">目外漬痛<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_005-1a.30"/><seg xml:id="CH8x3011_CHANT_005-1a.31">頰痛</seg><seg xml:id="CH8x3011_CHANT_005-1a.32"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_005-1a.33"/><seg xml:id="CH8x3011_CHANT_005-1a.34">耳聾<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_005-1a.35"/><seg xml:id="CH8x3011_CHANT_005-1a.36">為三病<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_005-1a.37"/></p>
         </div>
         <div>
                
<head xml:id="CH8x3011_CHANT_006-1a.1-h-h"><seg xml:id="CH8x3011_CHANT_006-1a.1-h">齒眽</seg></head>
            <p><seg xml:id="CH8x3011_CHANT_006-1a.1"/><seg xml:id="CH8x3011_CHANT_006-1a.2"/><seg xml:id="CH8x3011_CHANT_006-1a.3">齒眽<c n="："/></seg><seg xml:id="CH8x3011_CHANT_006-1a.4"/><seg xml:id="CH8x3011_CHANT_006-1a.5">起於次指與大指上<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.6"/><seg xml:id="CH8x3011_CHANT_006-1a.7">出臂上廉<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.8"/><seg xml:id="CH8x3011_CHANT_006-1a.9">入肘中<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.10"/><seg xml:id="CH8x3011_CHANT_006-1a.11">乘臑<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.12"/><seg xml:id="CH8x3011_CHANT_006-1a.13">穿</seg><seg xml:id="CH8x3011_CHANT_006-1a.14">頰<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.15"/><seg xml:id="CH8x3011_CHANT_006-1a.16">入齒中<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.17"/><seg xml:id="CH8x3011_CHANT_006-1a.18">夾鼻<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.19"/><seg xml:id="CH8x3011_CHANT_006-1a.20">是動</seg><seg xml:id="CH8x3011_CHANT_006-1a.21"/><seg xml:id="CH8x3011_CHANT_006-1a.22"/><seg xml:id="CH8x3011_CHANT_006-1a.23">則病<c n="："/></seg><seg xml:id="CH8x3011_CHANT_006-1a.24"/><seg xml:id="CH8x3011_CHANT_006-1a.25">齒痛<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.26"/><seg xml:id="CH8x3011_CHANT_006-1a.27">朏穜<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.28"/><seg xml:id="CH8x3011_CHANT_006-1a.29">是齒眽主治<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.30"/><seg xml:id="CH8x3011_CHANT_006-1a.31">其所產病<c n="："/></seg><seg xml:id="CH8x3011_CHANT_006-1a.32"/><seg xml:id="CH8x3011_CHANT_006-1a.33">齒痛<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.34"/><seg xml:id="CH8x3011_CHANT_006-1a.35">朏穜<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.36"/><seg xml:id="CH8x3011_CHANT_006-1a.37">目黃<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.38"/><seg xml:id="CH8x3011_CHANT_006-1a.39">口乾<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.40"/><seg xml:id="CH8x3011_CHANT_006-1a.41">臑痛<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.42"/><seg xml:id="CH8x3011_CHANT_006-1a.43">為五病</seg><seg xml:id="CH8x3011_CHANT_006-1a.44"><c n="。"/></seg><seg xml:id="CH8x3011_CHANT_006-1a.45"/></p>
         </div>
         <div>
                
<head xml:id="CH8x3011_CHANT_007-1a.1-h-h"><seg xml:id="CH8x3011_CHANT_007-1a.1-h">大陰眽</seg></head>
            <p><seg xml:id="CH8x3011_CHANT_007-1a.1"/><seg xml:id="CH8x3011_CHANT_007-1a.2"/><seg xml:id="CH8x3011_CHANT_007-1a.3">大陰眽<c n="："/></seg><seg xml:id="CH8x3011_CHANT_007-1a.4"/><seg xml:id="CH8x3011_CHANT_007-1a.5">是胃眽殹<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.6"/><seg xml:id="CH8x3011_CHANT_007-1a.7">彼胃<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.8"/><seg xml:id="CH8x3011_CHANT_007-1a.9">出魚股陰下廉<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.10"/><seg xml:id="CH8x3011_CHANT_007-1a.11">腨上廉<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.12"/><seg xml:id="CH8x3011_CHANT_007-1a.13">出內</seg><seg xml:id="CH8x3011_CHANT_007-1a.14">踝之上廉<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.15"/><seg xml:id="CH8x3011_CHANT_007-1a.16">是動則病<c n="："/></seg><seg xml:id="CH8x3011_CHANT_007-1a.17"/><seg xml:id="CH8x3011_CHANT_007-1a.18">上當</seg><seg xml:id="CH8x3011_CHANT_007-1a.19"/><seg xml:id="CH8x3011_CHANT_007-1a.20"/><seg xml:id="CH8x3011_CHANT_007-1a.21">走心<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.22"/><seg xml:id="CH8x3011_CHANT_007-1a.23">使復張<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.24"/><seg xml:id="CH8x3011_CHANT_007-1a.25">善噫<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.26"/><seg xml:id="CH8x3011_CHANT_007-1a.27">食欲歐<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.28"/><seg xml:id="CH8x3011_CHANT_007-1a.29">得後與氣則怢<c n="（"/>快<c n="）"/>然衰<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.30"/><seg xml:id="CH8x3011_CHANT_007-1a.31">是鉅<c n="（"/>太<c n="）"/>陰眽主治<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.32"/><seg xml:id="CH8x3011_CHANT_007-1a.33">其所產病</seg><seg xml:id="CH8x3011_CHANT_007-1a.34"><c n="："/></seg><seg xml:id="CH8x3011_CHANT_007-1a.35"/><seg xml:id="CH8x3011_CHANT_007-1a.36">□□<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.37"/><seg xml:id="CH8x3011_CHANT_007-1a.38">心煩<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.39"/><seg xml:id="CH8x3011_CHANT_007-1a.40">死<c n="；"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.41"/><seg xml:id="CH8x3011_CHANT_007-1a.42">心痛與復張<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.43"/><seg xml:id="CH8x3011_CHANT_007-1a.44">死<c n="；"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.45"/><seg xml:id="CH8x3011_CHANT_007-1a.46">不能食<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.47"/><seg xml:id="CH8x3011_CHANT_007-1a.48">不能卧<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.49"/><seg xml:id="CH8x3011_CHANT_007-1a.50">強吹<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.51"/><seg xml:id="CH8x3011_CHANT_007-1a.52">三者同則死<c n="；"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.53"/><seg xml:id="CH8x3011_CHANT_007-1a.54">唐泄<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.55"/><seg xml:id="CH8x3011_CHANT_007-1a.56">死<c n="；"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.57"/><seg xml:id="CH8x3011_CHANT_007-1a.58">水與</seg><seg xml:id="CH8x3011_CHANT_007-1a.59"/><seg xml:id="CH8x3011_CHANT_007-1a.60"/><seg xml:id="CH8x3011_CHANT_007-1a.61">閉同則死<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.62"/><seg xml:id="CH8x3011_CHANT_007-1a.63">為十病<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_007-1a.64"/></p>
         </div>
         <div>
                
<head xml:id="CH8x3011_CHANT_008-1a.1-h-h"><seg xml:id="CH8x3011_CHANT_008-1a.1-h">厥陰眽</seg></head>
            <p><seg xml:id="CH8x3011_CHANT_008-1a.1"/><seg xml:id="CH8x3011_CHANT_008-1a.2"/><seg xml:id="CH8x3011_CHANT_008-1a.3">厥陰眽<c n="："/></seg><seg xml:id="CH8x3011_CHANT_008-1a.4"/><seg xml:id="CH8x3011_CHANT_008-1a.5">𣪠於足大指菆毛</seg><seg xml:id="CH8x3011_CHANT_008-1a.6">之上<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-1a.7"/><seg xml:id="CH8x3011_CHANT_008-1a.8">乘足跗上廉</seg><seg xml:id="CH8x3011_CHANT_008-1a.9"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-1a.10"/><seg xml:id="CH8x3011_CHANT_008-1a.11">去內腂一寸<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-1a.12"/><seg xml:id="CH8x3011_CHANT_008-1a.13">上腂</seg><seg xml:id="CH8x3011_CHANT_008-1a.14">五寸而出大陰之後</seg><seg xml:id="CH8x3011_CHANT_008-1a.15"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-1a.16"/><seg xml:id="CH8x3011_CHANT_008-1a.17"/><seg xml:id="CH8x3011_CHANT_008-1a.18">上出魚股內廉<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-1a.19"/><seg xml:id="CH8x3011_CHANT_008-1a.20">觸少腹<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-1a.21"/><seg xml:id="CH8x3011_CHANT_008-1a.22">大漬旁<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_008-1a.23"/><seg xml:id="CH8x3011_CHANT_008-1a.24">是動則病</seg><seg xml:id="CH8x3011_CHANT_008-1a.25"><c n="："/></seg><seg xml:id="CH8x3011_CHANT_008-1a.26"/><seg xml:id="CH8x3011_CHANT_008-1a.27">丈</seg><seg xml:id="CH8x3011_CHANT_008-1a.28">夫隤山</seg><seg xml:id="CH8x3011_CHANT_008-1a.29"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-1a.30"/><seg xml:id="CH8x3011_CHANT_008-1a.31">婦人則少腹穜<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-1a.32"/><seg xml:id="CH8x3011_CHANT_008-1a.33">要痛</seg><seg xml:id="CH8x3011_CHANT_008-1a.34"/><seg xml:id="CH8x3011_CHANT_008-1a.35"/><seg xml:id="CH8x3011_CHANT_008-1a.36">不可以卬<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-1a.37"/><seg xml:id="CH8x3011_CHANT_008-1a.38">甚則嗌乾<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-1a.39"/><seg xml:id="CH8x3011_CHANT_008-1a.40">面疵<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-1a.41"/><seg xml:id="CH8x3011_CHANT_008-1a.42">是厥陰眽主治<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_008-1a.43"/></p>
            <p><seg xml:id="CH8x3011_CHANT_008-2a.1"/><seg xml:id="CH8x3011_CHANT_008-2a.2"/><seg xml:id="CH8x3011_CHANT_008-2a.3">其</seg><seg xml:id="CH8x3011_CHANT_008-2a.4">所產病<c n="："/></seg><seg xml:id="CH8x3011_CHANT_008-2a.5"/><seg xml:id="CH8x3011_CHANT_008-2a.6">熱中<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-2a.7"/><seg xml:id="CH8x3011_CHANT_008-2a.8">降</seg><seg xml:id="CH8x3011_CHANT_008-2a.9"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-2a.10"/><seg xml:id="CH8x3011_CHANT_008-2a.11">隤</seg><seg xml:id="CH8x3011_CHANT_008-2a.12"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-2a.13"/><seg xml:id="CH8x3011_CHANT_008-2a.14">扁山</seg><seg xml:id="CH8x3011_CHANT_008-2a.15"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-2a.16"/><seg xml:id="CH8x3011_CHANT_008-2a.17">□□</seg><seg xml:id="CH8x3011_CHANT_008-2a.18"/><seg xml:id="CH8x3011_CHANT_008-2a.19">五病</seg><seg xml:id="CH8x3011_CHANT_008-2a.20">有而心煩<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-2a.21"/><seg xml:id="CH8x3011_CHANT_008-2a.22">死<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-2a.23"/><seg xml:id="CH8x3011_CHANT_008-2a.24">勿治殹<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_008-2a.25"/><seg xml:id="CH8x3011_CHANT_008-2a.26">有陽眽與之俱</seg><seg xml:id="CH8x3011_CHANT_008-2a.27">病<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_008-2a.28"/><seg xml:id="CH8x3011_CHANT_008-2a.29">可治殹<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_008-2a.30"/></p>
         </div>
         <div>
                
<head xml:id="CH8x3011_CHANT_009-1a.1-h-h"><seg xml:id="CH8x3011_CHANT_009-1a.1-h">少陰眽</seg></head>
            <p><seg xml:id="CH8x3011_CHANT_009-1a.1"/><seg xml:id="CH8x3011_CHANT_009-1a.2"/><seg xml:id="CH8x3011_CHANT_009-1a.3">少陰眽<c n="："/></seg><seg xml:id="CH8x3011_CHANT_009-1a.4"/><seg xml:id="CH8x3011_CHANT_009-1a.5">𣪠於內腂外廉<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.6"/><seg xml:id="CH8x3011_CHANT_009-1a.7">穿腨<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.8"/><seg xml:id="CH8x3011_CHANT_009-1a.9">出𦛱中</seg><seg xml:id="CH8x3011_CHANT_009-1a.10">央<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.11"/><seg xml:id="CH8x3011_CHANT_009-1a.12">上穿脊之□廉<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.13"/><seg xml:id="CH8x3011_CHANT_009-1a.14">𣪠於腎<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.15"/><seg xml:id="CH8x3011_CHANT_009-1a.16">夾舌本</seg><seg xml:id="CH8x3011_CHANT_009-1a.17"><c n="。"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.18"/><seg xml:id="CH8x3011_CHANT_009-1a.19">是動則病</seg><seg xml:id="CH8x3011_CHANT_009-1a.20"><c n="："/></seg><seg xml:id="CH8x3011_CHANT_009-1a.21"/><seg xml:id="CH8x3011_CHANT_009-1a.22" n="CH0F225ECH0F225E"><c n="&amp;"/><c n="-"/><c n=";"/><c n="&amp;"/><c n="-"/><c n=";"/>如喘<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.23"/><seg xml:id="CH8x3011_CHANT_009-1a.24">坐而起則目瞙如毋見<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.25"/><seg xml:id="CH8x3011_CHANT_009-1a.26">心如縣<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.27"/><seg xml:id="CH8x3011_CHANT_009-1a.28">病飢<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.29"/><seg xml:id="CH8x3011_CHANT_009-1a.30">氣不足</seg><seg xml:id="CH8x3011_CHANT_009-1a.31"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.32"/><seg xml:id="CH8x3011_CHANT_009-1a.33">善怒<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.34"/><seg xml:id="CH8x3011_CHANT_009-1a.35">心腸<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.36"/><seg xml:id="CH8x3011_CHANT_009-1a.37">恐人將捕之</seg><seg xml:id="CH8x3011_CHANT_009-1a.38"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.39"/><seg xml:id="CH8x3011_CHANT_009-1a.40"/><seg xml:id="CH8x3011_CHANT_009-1a.41">不欲食<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.42"/><seg xml:id="CH8x3011_CHANT_009-1a.43" n="CH0F225F">面黭<c n="（"/>黯<c n="）"/>若<c n="&amp;"/><c n="-"/><c n=";"/>色<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.44"/><seg xml:id="CH8x3011_CHANT_009-1a.45">欬則有血<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.46"/><seg xml:id="CH8x3011_CHANT_009-1a.47">此為骨蹶<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.48"/><seg xml:id="CH8x3011_CHANT_009-1a.49">是少陰</seg><seg xml:id="CH8x3011_CHANT_009-1a.50">眽主治</seg><seg xml:id="CH8x3011_CHANT_009-1a.51"><c n="。"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.52"/><seg xml:id="CH8x3011_CHANT_009-1a.53">其所產病</seg><seg xml:id="CH8x3011_CHANT_009-1a.54"><c n="："/></seg><seg xml:id="CH8x3011_CHANT_009-1a.55"/><seg xml:id="CH8x3011_CHANT_009-1a.56">口熱</seg><seg xml:id="CH8x3011_CHANT_009-1a.57"/><seg xml:id="CH8x3011_CHANT_009-1a.58"/><seg xml:id="CH8x3011_CHANT_009-1a.59">舌柝<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.60"/><seg xml:id="CH8x3011_CHANT_009-1a.61">嗌乾<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.62"/><seg xml:id="CH8x3011_CHANT_009-1a.63">上氣<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.64"/><seg xml:id="CH8x3011_CHANT_009-1a.65">饐<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.66"/><seg xml:id="CH8x3011_CHANT_009-1a.67">嗌中痛<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.68"/><seg xml:id="CH8x3011_CHANT_009-1a.69">癉<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.70"/><seg xml:id="CH8x3011_CHANT_009-1a.71">耆卧<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.72"/><seg xml:id="CH8x3011_CHANT_009-1a.73">欬<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.74"/><seg xml:id="CH8x3011_CHANT_009-1a.75">音<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.76"/><seg xml:id="CH8x3011_CHANT_009-1a.77">為十病<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.78"/><seg xml:id="CH8x3011_CHANT_009-1a.79">少</seg><seg xml:id="CH8x3011_CHANT_009-1a.80">陰之眽<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.81"/><seg xml:id="CH8x3011_CHANT_009-1a.82">久則強食產肉</seg><seg xml:id="CH8x3011_CHANT_009-1a.83"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.84"/><seg xml:id="CH8x3011_CHANT_009-1a.85">緩帶</seg><seg xml:id="CH8x3011_CHANT_009-1a.86"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.87"/><seg xml:id="CH8x3011_CHANT_009-1a.88"/><seg xml:id="CH8x3011_CHANT_009-1a.89">皮髮<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.90"/><seg xml:id="CH8x3011_CHANT_009-1a.91">大丈<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.92"/><seg xml:id="CH8x3011_CHANT_009-1a.93">重履而步<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.94"/><seg xml:id="CH8x3011_CHANT_009-1a.95">久幾息則病已矣<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_009-1a.96"/></p>
         </div>
         <div>
                
<head xml:id="CH8x3011_CHANT_010-1a.1-h-h"><seg xml:id="CH8x3011_CHANT_010-1a.1-h">臂鉅陰眽</seg></head>
            <p><seg xml:id="CH8x3011_CHANT_010-1a.1"/><seg xml:id="CH8x3011_CHANT_010-1a.2"/><seg xml:id="CH8x3011_CHANT_010-1a.3">臂鉅陰眽<c n="："/></seg><seg xml:id="CH8x3011_CHANT_010-1a.4"/><seg xml:id="CH8x3011_CHANT_010-1a.5">在於手掌中<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.6"/><seg xml:id="CH8x3011_CHANT_010-1a.7">出內陰兩骨之間<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.8"/><seg xml:id="CH8x3011_CHANT_010-1a.9">上骨下廉<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.10"/><seg xml:id="CH8x3011_CHANT_010-1a.11">筋之上<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.12"/><seg xml:id="CH8x3011_CHANT_010-1a.13">出臂內陰</seg><seg xml:id="CH8x3011_CHANT_010-1a.14"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.15"/><seg xml:id="CH8x3011_CHANT_010-1a.16">入心中</seg><seg xml:id="CH8x3011_CHANT_010-1a.17"><c n="。"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.18"/><seg xml:id="CH8x3011_CHANT_010-1a.19"/><seg xml:id="CH8x3011_CHANT_010-1a.20">是動則病<c n="："/></seg><seg xml:id="CH8x3011_CHANT_010-1a.21"/><seg xml:id="CH8x3011_CHANT_010-1a.22">心滂滂<c n="（"/>彭彭<c n="）"/>如痛<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.23"/><seg xml:id="CH8x3011_CHANT_010-1a.24">缺盆痛<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.25"/><seg xml:id="CH8x3011_CHANT_010-1a.26">甚則</seg><seg xml:id="CH8x3011_CHANT_010-1a.27">交兩手而戰<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.28"/><seg xml:id="CH8x3011_CHANT_010-1a.29">此為臂蹶<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.30"/><seg xml:id="CH8x3011_CHANT_010-1a.31">是臂鉅陰眽主</seg><seg xml:id="CH8x3011_CHANT_010-1a.32"/><seg xml:id="CH8x3011_CHANT_010-1a.33"/><seg xml:id="CH8x3011_CHANT_010-1a.34">治<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.35"/><seg xml:id="CH8x3011_CHANT_010-1a.36">其所產病<c n="："/></seg><seg xml:id="CH8x3011_CHANT_010-1a.37"/><seg xml:id="CH8x3011_CHANT_010-1a.38">𦙞痛<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.39"/><seg xml:id="CH8x3011_CHANT_010-1a.40" n="CH0F2260"><c n="&amp;"/><c n="-"/><c n=";"/>痛<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.41"/><seg xml:id="CH8x3011_CHANT_010-1a.42">心痛</seg><seg xml:id="CH8x3011_CHANT_010-1a.43"><c n="，"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.44"/><seg xml:id="CH8x3011_CHANT_010-1a.45">四末痛<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.46"/><seg xml:id="CH8x3011_CHANT_010-1a.47">叚<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.48"/><seg xml:id="CH8x3011_CHANT_010-1a.49">為五病<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_010-1a.50"/></p>
         </div>
         <div>
                
<head xml:id="CH8x3011_CHANT_011-1a.1-h-h"><seg xml:id="CH8x3011_CHANT_011-1a.1-h">臂少陰眽</seg></head>
            <p><seg xml:id="CH8x3011_CHANT_011-1a.1"/><seg xml:id="CH8x3011_CHANT_011-1a.2"/><seg xml:id="CH8x3011_CHANT_011-1a.3">臂少陰眽<c n="："/></seg><seg xml:id="CH8x3011_CHANT_011-1a.4"/><seg xml:id="CH8x3011_CHANT_011-1a.5">起於臂兩骨之間</seg><seg xml:id="CH8x3011_CHANT_011-1a.6"/><seg xml:id="CH8x3011_CHANT_011-1a.7">之間<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_011-1a.8"/><seg xml:id="CH8x3011_CHANT_011-1a.9">下骨上廉<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_011-1a.10"/><seg xml:id="CH8x3011_CHANT_011-1a.11">筋之下<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_011-1a.12"/><seg xml:id="CH8x3011_CHANT_011-1a.13">出</seg><seg xml:id="CH8x3011_CHANT_011-1a.14">臑內陰<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_011-1a.15"/><seg xml:id="CH8x3011_CHANT_011-1a.16">入心中是動則病</seg><seg xml:id="CH8x3011_CHANT_011-1a.17"><c n="："/></seg><seg xml:id="CH8x3011_CHANT_011-1a.18"/><seg xml:id="CH8x3011_CHANT_011-1a.19">心</seg><seg xml:id="CH8x3011_CHANT_011-1a.20"/><seg xml:id="CH8x3011_CHANT_011-1a.21"/><seg xml:id="CH8x3011_CHANT_011-1a.22">痛<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_011-1a.23"/><seg xml:id="CH8x3011_CHANT_011-1a.24">益渴欲飲<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_011-1a.25"/><seg xml:id="CH8x3011_CHANT_011-1a.26">此為臂蹶<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_011-1a.27"/><seg xml:id="CH8x3011_CHANT_011-1a.28">是臂少陰眽主治<c n="。"/></seg><seg xml:id="CH8x3011_CHANT_011-1a.29"/><seg xml:id="CH8x3011_CHANT_011-1a.30">其所產病</seg><seg xml:id="CH8x3011_CHANT_011-1a.31"><c n="："/></seg><seg xml:id="CH8x3011_CHANT_011-1a.32"/><seg xml:id="CH8x3011_CHANT_011-1a.33">脅</seg><seg xml:id="CH8x3011_CHANT_011-1a.34">痛<c n="，"/></seg><seg xml:id="CH8x3011_CHANT_011-1a.35"/><seg xml:id="CH8x3011_CHANT_011-1a.36">為一病</seg><seg xml:id="CH8x3011_CHANT_011-1a.37"><c n="。"/></seg><seg xml:id="CH8x3011_CHANT_011-1a.38"/></p>
         </div>
