<head xml:id="CH8x4422_CHANT_001-1a.1-h-h"><seg xml:id="CH8x4422_CHANT_001-1a.1-h">一</seg></head>
            <p><seg xml:id="CH8x4422_CHANT_001-1a.1"/><seg xml:id="CH8x4422_CHANT_001-1a.2">凡人雖有性<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.3">心亡奠志<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.4">待物而後作<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.5">待悅而後行<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.6">待習而後</seg><seg xml:id="CH8x4422_CHANT_001-1a.7">奠<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.8">喜怒哀悲之氣<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.9">性也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.10">及其見於外<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.11">則物取之也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.12">性自命出<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.13" resp="#CH" modified="2025-12-03T22:45:37.627+09:00">命自天降。</seg><seg xml:id="CH8x4422_CHANT_001-1a.15">道始於情<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.16">情生於性<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.17">始者近情<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.18">終者近義<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.19" resp="#CH" modified="2025-12-03T22:47:25.667+09:00">知情者能出之。</seg><seg xml:id="CH8x4422_CHANT_001-1a.20" resp="#CH" modified="2025-12-03T22:47:00.589+09:00"/><seg xml:id="CH8x4422_CHANT_001-1a.21">知義者能納之<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.22">好惡<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.23">性也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.24">所好所惡<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.25">物也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.26">善<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.27">不善<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.28">性也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.29">所善所不善<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.30">勢也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.31">凡性為主<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.32">物取之也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.33">金石之有聲<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.34">弗扣不</seg><seg xml:id="CH8x4422_CHANT_001-1a.35">鳴<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.36">人之雖有性<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.37">心弗取不出<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.38">凡心有志也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.39">亡與不可<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.40">心之不可</seg><seg xml:id="CH8x4422_CHANT_001-1a.41">獨行<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.42">猶口之不可獨言也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.43">牛生而長<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.44">雁生而伸<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.45">其性使然<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.46">人</seg><seg xml:id="CH8x4422_CHANT_001-1a.47">而學<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.48">或使之也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.49">凡物亡不異也者<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.50">剛之柱也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.51">剛取之也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.52">柔之</seg><seg xml:id="CH8x4422_CHANT_001-1a.53">約<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.54">柔取之也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.55">四海之內其性一也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.56">其用心各異<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.57">教使然也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.58">凡性</seg><seg xml:id="CH8x4422_CHANT_001-1a.59">或動之<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.60">或逆之<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.61">或交之<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.62">或厲之<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.63">或出之<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.64">或養之<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.65">或長之<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.66">凡動性</seg><seg xml:id="CH8x4422_CHANT_001-1a.67">者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.68">物也<c n="；"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.69">逆性者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.70">悅也<c n="；"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.71">交性者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.72">故也<c n="；"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.73">厲性者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.74">義也<c n="；"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.75">出性者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.76">勢也<c n="；"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.77">養性</seg><seg xml:id="CH8x4422_CHANT_001-1a.78">者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.79">習也<c n="；"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.80">長性者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.81">道也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.82">凡見者之謂物<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.83">快於己者之謂悅<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.84">物</seg><seg xml:id="CH8x4422_CHANT_001-1a.85">之制者之謂勢<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.86">有為也者之謂故<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.87">義也者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.88">群善之蕝也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.89">習也</seg><seg xml:id="CH8x4422_CHANT_001-1a.90">者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.91">有以習其性也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.92">道者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.93">群物之道<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.94">凡道<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.95">心術為主<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.96">道四術<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.97">唯</seg><seg xml:id="CH8x4422_CHANT_001-1a.98">人道為可道也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.99">其三術者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_001-1a.100">道之而已<c n="。"/></seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4422_CHANT_002-1a.1-h-h"><seg xml:id="CH8x4422_CHANT_002-1a.1-h">二</seg></head>
            <p><seg xml:id="CH8x4422_CHANT_002-1a.1"/><seg xml:id="CH8x4422_CHANT_002-1a.2">詩<c n="、"/>書<c n="、"/>禮<c n="、"/>樂<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_002-1a.3">其始出皆生</seg><seg xml:id="CH8x4422_CHANT_002-1a.4">於人<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_002-1a.5">詩<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_002-1a.6">有為為之也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_002-1a.7">書<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_002-1a.8">有為言之也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_002-1a.9">禮<c n="、"/>樂<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_002-1a.10">有為舉之也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_002-1a.11">聖人比其</seg><seg xml:id="CH8x4422_CHANT_002-1a.12">類而論會之<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_002-1a.13">觀其先後而訓之<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_002-1a.14">體其義而次序之<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_002-1a.15">理</seg><seg xml:id="CH8x4422_CHANT_002-1a.16">其情而出入之<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_002-1a.17">然後復以教<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_002-1a.18">教<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_002-1a.19">所以生德于中者也<c n="。"/></seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4422_CHANT_003-1a.1-h-h"><seg xml:id="CH8x4422_CHANT_003-1a.1-h">三</seg></head>
            <p><seg xml:id="CH8x4422_CHANT_003-1a.1"/><seg xml:id="CH8x4422_CHANT_003-1a.2">禮<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.3">作於情<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.4">或興之也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.5">當事因方而制之<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.6">其先後之序則義道也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.7">或序為</seg><seg xml:id="CH8x4422_CHANT_003-1a.8">之節則度也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.9">至容貌<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.10">所以度<c n="、"/>節也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.11">君子美其情<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.12">貴其義<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.13">善其節<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.14">好其容<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.15">樂其道<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.16">悅其教<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.17">是以敬焉<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.18">拜<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.19">所以為服也</seg><seg xml:id="CH8x4422_CHANT_003-1a.20">其諛<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.21">度也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.22">幣帛<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.23">所以為信與徵也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.24">其貽<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.25">義道也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.26">笑<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.27">禮之淺澤也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.28">樂<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_003-1a.29">禮之深澤也<c n="。"/></seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4422_CHANT_004-1a.1-h-h"><seg xml:id="CH8x4422_CHANT_004-1a.1-h">四</seg></head>
            <p><seg xml:id="CH8x4422_CHANT_004-1a.1"/><seg xml:id="CH8x4422_CHANT_004-1a.2">凡聲<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.3">其出於情也信<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.4">然後其入撥人之心也厚<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.5">聞笑聲<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.6">則鮮如也斯喜<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.7">聞歌謠<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.8">則陶如也斯奮<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.9">聽琴瑟之聲則</seg><seg xml:id="CH8x4422_CHANT_004-1a.10">悸如也斯戁<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.11">觀<c n="《"/>㒀<c n="》"/><c n="、"/><c n="《"/>武<c n="》"/><c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.12">則齊如也斯作<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.13">觀<c n="《"/>韶<c n="》"/><c n="、"/><c n="《"/>夏<c n="》"/><c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.14">則勉如也</seg><seg xml:id="CH8x4422_CHANT_004-1a.15">斯儉<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.16">詠思而動心<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.17">喟如也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.18">其居節也舊<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.19">其反善復始也</seg><seg xml:id="CH8x4422_CHANT_004-1a.20">慎<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.21">其入也順<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.22">主其德也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.23">鄭衛之樂<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.24">則非其聲而縱之也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.25">凡古樂和心<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.26">益樂和指<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.27">皆教其人者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.28"><c n="《"/>賚<c n="》"/><c n="、"/><c n="《"/>武<c n="》"/>樂取<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.29"><c n="《"/>韶<c n="》"/><c n="、"/><c n="《"/>夏<c n="》"/>樂情<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.30">凡至樂必悲<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.31">哭亦悲<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.32">皆至其情也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.33" resp="#CH" modified="2025-03-08T22:10:47.667+09:00">哀樂，</seg><seg xml:id="CH8x4422_CHANT_004-1a.34">其性相近也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.35">是故其心</seg><seg xml:id="CH8x4422_CHANT_004-1a.36">不遠<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.37">哭之動心也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.38">浸殺<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.39">其剌戀戀如也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.40">戚然以終<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.41">樂之動心也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.42">濬深鬱滔<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.43">其刺則流如也以悲<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.44">悠然以思<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.45">凡憂思而後悲<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.46">凡樂思而後忻<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.47">凡思之用心為甚<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.48">戁<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.49">思之方也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.50">其聲變則其心變<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.51">其心變<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.52">則其聲亦然<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.53">吟由哀也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.54">噪由樂也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.55">啾由聲也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.56">嘔由心也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.57">喜斯慆<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.58">慆斯奮<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.59">奮斯迹<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.60">迹斯猷<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.61">猷斯舞<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.62">舞<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.63">喜之終也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.64">慍斯憂<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.65">憂斯戚<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.66">戚斯難<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.67">難斯戁<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.68">戁斯踊<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.69">踊<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_004-1a.70">慍之終也<c n="。"/></seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4422_CHANT_005-1a.1-h-h"><seg xml:id="CH8x4422_CHANT_005-1a.1-h">五</seg></head>
            <p><seg xml:id="CH8x4422_CHANT_005-1a.1"/><seg xml:id="CH8x4422_CHANT_005-1a.2">凡學者求其心為難<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.3">從其所為<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.4">近得之矣<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.5">不如以樂之速也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.6">雖能其事<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.7">不能其心<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.8">不貴<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.9">求其心有偽也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.10">弗得之矣<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.11">人之不能以偽也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.12">可知也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.13">其過十舉<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.14">其心必在焉<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.15">察其見者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.16">情焉失哉<c n="？"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.17">察<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.18">義之方也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.19">義<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.20">敬之方也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.21">敬<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.22">物之節也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.23">篤<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.24">仁之方也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.25">仁<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.26">性之方也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.27">性或生之<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.28">忠<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.29">信</seg><seg xml:id="CH8x4422_CHANT_005-1a.30">之方也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.31">信<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.32">情之方也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.33">情出於性<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.34">愛類七<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.35">唯性愛為近仁<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.36">智類五<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.37">唯</seg><seg xml:id="CH8x4422_CHANT_005-1a.38">義道為近忠<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.39">惡類三<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.40">惡不仁為近義<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.41">所為道者四<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.42">唯人道為</seg><seg xml:id="CH8x4422_CHANT_005-1a.43">可道也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.44">凡用心之躁者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.45">思為甚<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.46">用智之疾者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.47">患為甚<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.48">用情之</seg><seg xml:id="CH8x4422_CHANT_005-1a.49">至者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.50">哀樂為甚<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.51">用身之變者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.52">悅為甚<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.53">用力之盡者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.54">利為甚<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.55">目之好</seg><seg xml:id="CH8x4422_CHANT_005-1a.56">色<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.57">耳之樂聲<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.58">鬱滔之氣也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.59">人不難為之死<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.60">有其為人之節節如也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.61">不有夫柬柬之心則采<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.62">有其為人之柬柬如也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.63">不有夫恒始之志則漫<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.64">人之巧</seg><seg xml:id="CH8x4422_CHANT_005-1a.65">言利詞者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.66">不有夫詘詘之心則流<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.67">人之悅然可與和安者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.68">不有夫奮</seg><seg xml:id="CH8x4422_CHANT_005-1a.69">作為之情則侮<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.70">有其為人之快如也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.71">弗牧不可<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.72">有其為人之淵如也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.73">弗輔不足<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.74">凡人𢠿為可惡也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.75">𢠿斯吝矣<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.76">吝斯慮矣<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.77">慮斯莫與之</seg><seg xml:id="CH8x4422_CHANT_005-1a.78">結矣<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.79">慎<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.80">仁之方也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.81">然而其過不惡<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.82">速<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.83">謀之方也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.84">有過則咎<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.85">人不慎斯有過<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.86">信矣<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.87">凡人之情為可悅也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.88">苟以其情<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.89">雖過不惡<c n="；"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.90">不以其情<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.91">雖難不貴<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.92">苟有其情<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.93">雖未之為<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_005-1a.94">斯人信之矣<c n="。"/></seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4422_CHANT_006-1a.1-h-h"><seg xml:id="CH8x4422_CHANT_006-1a.1-h">六</seg></head>
            <p><seg xml:id="CH8x4422_CHANT_006-1a.1"/><seg xml:id="CH8x4422_CHANT_006-1a.2">未言而信<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.3">有美情者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.4">未教</seg><seg xml:id="CH8x4422_CHANT_006-1a.5">而民恒<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.6">性善者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.7">未賞而民勸<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.8">含福者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.9">未刑而民畏<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.10">有</seg><seg xml:id="CH8x4422_CHANT_006-1a.11">心畏者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.12">賤而民貴之<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.13">有德者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.14">貧而民聚焉<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.15">有道者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.16">獨處而樂<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.17">有入禮者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.18">惡之而不可非者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.19">達於義者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.20">非之</seg><seg xml:id="CH8x4422_CHANT_006-1a.21">而不可惡者<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.22">篤於仁者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.23">行之不過<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.24">知道者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.25">聞道反上<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.26">上交者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.27">聞道反下<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.28">下交者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.29">聞反己<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.30">修身者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.31">上交近事君<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.32">下交得</seg><seg xml:id="CH8x4422_CHANT_006-1a.33">眾近從政<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.34">修身近至仁<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.35">同方而交<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.36">以道者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.37">不同方而交<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.38">以義者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.39">同悅而交<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.40">以德者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.41">不同悅而交<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.42">以謀者也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.43">門內之治<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.44">欲其</seg><seg xml:id="CH8x4422_CHANT_006-1a.45">逸也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.46">門外之治<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_006-1a.47">欲其制也<c n="。"/></seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4422_CHANT_007-1a.1-h-h"><seg xml:id="CH8x4422_CHANT_007-1a.1-h">七</seg></head>
            <p><seg xml:id="CH8x4422_CHANT_007-1a.1"/><seg xml:id="CH8x4422_CHANT_007-1a.2">凡悅人勿吝也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.3">身必從之<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.4">言及則</seg><seg xml:id="CH8x4422_CHANT_007-1a.5">明<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.6">舉之而毋𢠿<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.7">凡交毋央<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.8">必使有末<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.9">凡於徵毋畏<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.10">毋獨言<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.11">獨</seg><seg xml:id="CH8x4422_CHANT_007-1a.12">處則習父兄之所樂<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.13">苟無大害<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.14">少枉入之可也<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.15">已則勿復言也<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.16">凡憂患之事欲任<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.17">樂事欲後<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.18">身欲靜而毋憾<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.19">慮欲淵而毋𢠿<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.20">行欲勇而必至<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.21">貌欲壯而毋拔<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.22">心欲柔齊而泊<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.23">喜欲智而亡末<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.24">樂欲懌而又有志<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.25">憂欲斂而毋昏<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.26">怒欲浧而毋希<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.27">進欲遜而毋巧<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.28">退欲尋而毋輕<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_007-1a.29">欲皆度而毋𢠿<c n="。"/></seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4422_CHANT_008-1a.1-h-h"><seg xml:id="CH8x4422_CHANT_008-1a.1-h">八</seg></head>
            <p><seg xml:id="CH8x4422_CHANT_008-1a.1"/><seg xml:id="CH8x4422_CHANT_008-1a.2">君子執志必有夫廣廣之心<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_008-1a.3">出言必有</seg><seg xml:id="CH8x4422_CHANT_008-1a.4">夫柬柬之信<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_008-1a.5">賓客之禮必有夫齊齊之容<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_008-1a.6">祭祀之禮必有夫齊齊之敬<c n="，"/></seg><seg xml:id="CH8x4422_CHANT_008-1a.7">居喪必有夫戀戀之哀<c n="。"/></seg><seg xml:id="CH8x4422_CHANT_008-1a.8">君子身以為主心<c n="。"/></seg></p>
         </div>
      </body>
   </text>
</TEI>