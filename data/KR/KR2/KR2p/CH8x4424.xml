         <div>
                
<head xml:id="CH8x4424_CHANT_001-1a.1-h-h">
                    <seg xml:id="CH8x4424_CHANT_001-1a.1-h">郭店楚簡十五《語叢一》</seg>
                </head>
            <p>
                    <seg xml:id="CH8x4424_CHANT_001-1a.1"/>
                    <seg xml:id="CH8x4424_CHANT_001-1a.2">凡物由亡生<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.3">有天有命<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.4">有物有名</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.5">天生倫<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.6">人生化<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.7">有命有度有名<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.8">而後</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.9">有倫<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.10">有地有形有盡<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.11">而後</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.12">有厚<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.13">有生有知<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.14">而後好惡</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.15">生<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.16">有物有倫有綠<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.17">而後</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.18">教生<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.19">有天有命<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.20">有地有形<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.21">有物有容<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.22">有色有名<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.23">有物有容<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.24">有盡有厚<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.25">有美有善<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.26">有仁有智<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.27">有義有禮<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.28">有聖有善<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.29">天生百物<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.30">人為貴<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.31">人</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.32">之道也<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.33">或由中出<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.34">或由外入<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.35">由中出者<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.36">仁<c n="、"/>忠<c n="、"/>信<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.37">由外入者<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.38">禮<c n="、"/>樂<c n="、"/>刑<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.39">仁生於人<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.40">義生於道<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.41">或生於內<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.42">或生於外<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.43">仁生德<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.44">德生禮<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.45">禮生樂<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.46">由樂</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.47">知刑<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.48">知己而後知人<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.49">知人而後知禮<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.50">知禮而後知行<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.51">其知博<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.52">然後知命<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.53">知天所為<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.54">知人所為<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.55">然後知道<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.56">知道然後知命<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.57">禮因人之情而為之<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.58">善理而後樂生<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.59">禮生於莊<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.60">樂生於度<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.61">禮齊樂靈則戚<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.62">樂繁</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.63">禮靈則慢<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.64">
                        <c n="《"/>易<c n="》"/>所以會天道人道</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.65">也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.66">
                        <c n="《"/>詩<c n="》"/>所以會古今之志</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.67">也者<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.68">
                        <c n="《"/>春秋<c n="》"/>所以會古今之</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.69">事也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.70">禮<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.71">交之行述也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.72">樂<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.73">或生或教者也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.74">
                        <c n="《"/>書<c n="》"/>所以會古今之識者也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.75">凡有血氣者<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.76">皆有喜</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.77">有怒<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.78">有慎有莊<c n="；"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.79">其體</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.80">有容<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.81">有色有聲<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.82">有嗅有味<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.83">有氣有志<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.84" resp="#CH" modified="2023-09-30T20:29:38.048+09:00">凡物有本有卯，</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.86">有終有始<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.87">容色<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.88">目司也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.89">聲<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.90" resp="#CH" modified="2023-09-30T20:32:33.096+09:00">耳司也。</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.92">嗅<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.93">鼻司也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.94">味<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.95">口司</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.96">也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.97">氣<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.98">容司也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.99">志<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.100">心之司<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.101">義亡能偽也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.102">賢者能理之<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.103">為孝<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.104">此非孝也<c n="；"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.105">為弟<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.106">此非弟也<c n="；"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.107">不可為也<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.108">而不可不為也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.109">為之<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.110">此非也<c n="；"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.111">弗為<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.112">此非也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.113">政其然而行<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.114">治焉爾也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.115">政不達<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.116">且生乎不達</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.117">其然也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.118">教<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.119">學其也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.120">其生也亡為乎<c n="？"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.121">其形</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.122">知禮然後知刑<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.123">刑非稽也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.124">上下皆得其所之謂信<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.125">信非至齊也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.126">政其然而行怠安<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.127">察天道以化民氣<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.128">父子<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.129">至上下也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.130">兄弟<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.131">至先後也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.132">亡物不物<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.133">皆致焉<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.134">而</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.135">亡非己取之者<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.136">悲亡其所也<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.137">亡非是</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.138">之弗也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.139">者<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.140">去寇不逮<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.141">從一道<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.142">惡人者義<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.143">然不然<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.144">厚於仁<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.145">薄於義<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.146">親而</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.147">不尊父<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.148">有親有尊<c n="；"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.149">尊而不親<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.150">長弟<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.151">親道也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.152">友君臣<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.153">無親也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.154">不尊<c n="；"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.155">厚於義<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.156">薄於仁</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.157">人亡能為<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.158">有察善<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.159">亡為善<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.160">察所知<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.161">察所不知<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.162">勢與聖為可察也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.163">君臣<c n="、"/>朋友<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.164">其擇者也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.165">賓客<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.166">清廟之度也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.167">多好者<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.168">亡好者也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.169">數<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.170">不盡也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.171">缺生乎未得也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.172">愛善之謂仁<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.173">仁義為之臬<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.174">備之謂聖<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.175">堲由敬作<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.176">有生乎名<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.177">節<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.178">度者也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.179">喪<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.180">仁之端也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.181">求者<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.182">亡有自來也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.183">浧聖之謂聖<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.184">權<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.185">可去可徙<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.186">凡同者通<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.187">禮不同<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.188">不豐<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.189">不殺<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.190">凡物由望生<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.191">物各止於其所<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.192">我行</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.193">皆有之<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.194">决與信<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.195">器也<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.196">各以詹</seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.197">詞毀也<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.198">乎與容與夫其行者<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.199">食與色與<c n="，"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.200">疾<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.201">止之<c n="。"/>
                    </seg>
                    <seg xml:id="CH8x4424_CHANT_001-1a.202">樂疏<c n="。"/>
                    </seg>
                </p>
         </div>
      </body>
   </text>
</TEI>