<head xml:id="CH2a1371_CHANT_001-1a.1-h-h"><seg xml:id="CH2a1371_CHANT_001-1a.1-h">《周生烈子》</seg></head>
            <p><seg xml:id="CH2a1371_CHANT_001-1a.1"/><seg xml:id="CH2a1371_CHANT_001-1a.2">天下所以平者<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.3">政平也<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.4">政所以平者<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.5">心平也<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.6">心所以平者<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.7">衡平也<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.8">衡所以平者<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.9">銖兩平也<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.10">銖兩所平者<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.11">毫釐平也<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.12">無所不均也<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.13">無所不平也<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.14">謂之太平<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.15">夫天之于物<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.16">無所偏以<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.17">君之散恩<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.18">無所內外<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-1a.19"><c n="《"/>太平御覽<c n="》"/><c n="。"/></seg></p>
            <p><seg xml:id="CH2a1371_CHANT_001-2a.1"/><seg xml:id="CH2a1371_CHANT_001-2a.2">心者眾智之門<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-2a.3">要物皆求於心<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-2a.4"><c n="《"/>太平御覽<c n="》"/><c n="。"/></seg></p>
            <p><seg xml:id="CH2a1371_CHANT_001-2a.5">口者言之門<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-2a.6"><c n="《"/>太平御覽<c n="》"/><c n="。"/></seg></p>
            <p><seg xml:id="CH2a1371_CHANT_001-2a.7">夫忠謇朝之把扒<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-2a.8">正人國之掃篲也<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-2a.9">秉把執篲<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-2a.10">除凶掃穢<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-2a.11">國之福<c n="、"/>主之利也<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-2a.12"><c n="《"/>太平御覽<c n="》"/><c n="。"/></seg></p>
            <p><seg xml:id="CH2a1371_CHANT_001-3a.1"/><seg xml:id="CH2a1371_CHANT_001-3a.2">舜嘗駕五龍以騰唐衢<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-3a.3">武嘗服九駮以馳文塗<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-3a.4">此上御也<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-3a.5"><c n="《"/>困學紀聞<c n="》"/><c n="。"/></seg></p>
            <p><seg xml:id="CH2a1371_CHANT_001-3a.6">居堯舜之位而不行唐虞之政者<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-3a.7">猶反衣狐白<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-3a.8">步牽騄耳<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-3a.9"><c n="《"/>太平御覽<c n="》"/><c n="。"/></seg></p>
            <p><seg xml:id="CH2a1371_CHANT_001-4a.1"/><seg xml:id="CH2a1371_CHANT_001-4a.2">桀紂是湯武之梯<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-4a.3">秦項是大漢之階也<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-4a.4">四逆不興<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-4a.5">則三順不勝<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-4a.6"><c n="《"/>太平御覽<c n="》"/><c n="。"/></seg></p>
            <p><seg xml:id="CH2a1371_CHANT_001-4a.7">夫獵葉之風<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-4a.8">不應八節<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-4a.9"><c n="《"/>太平御覽<c n="》"/><c n="。"/></seg></p>
            <p><seg xml:id="CH2a1371_CHANT_001-5a.1"/><seg xml:id="CH2a1371_CHANT_001-5a.2">行賞不洽<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-5a.3">是春半生也<c n="；"/></seg><seg xml:id="CH2a1371_CHANT_001-5a.4">行罰不威<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-5a.5">是秋半死也<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-5a.6">半生之春不洽于仁<c n="，"/></seg><seg xml:id="CH2a1371_CHANT_001-5a.7">半死之秋不專于義<c n="。"/></seg><seg xml:id="CH2a1371_CHANT_001-5a.8"><c n="《"/>太平御覽<c n="》"/><c n="。"/></seg></p>
         </div>
      </body>
