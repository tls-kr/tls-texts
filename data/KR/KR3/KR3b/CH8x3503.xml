            <p><seg xml:id="CH8x3503_CHANT_001-12a.1"/><seg xml:id="CH8x3503_CHANT_001-12a.2">三<c n="："/></seg><seg xml:id="CH8x3503_CHANT_001-12a.3"/></p>
            <p><seg xml:id="CH8x3503_CHANT_001-12a.4"/><seg xml:id="CH8x3503_CHANT_001-12a.5"><c n="…"/><c n="…"/>仁矢盡於郭中<c n="…"/><c n="…"/>毀折入此<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.6"/><seg xml:id="CH8x3503_CHANT_001-12a.7">令客氣數什百倍<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.8"/><seg xml:id="CH8x3503_CHANT_001-12a.9">而主人氣不半□□□</seg><seg xml:id="CH8x3503_CHANT_001-12a.10">者傷守甚者也<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.11"/><seg xml:id="CH8x3503_CHANT_001-12a.12">然而世□</seg><seg xml:id="CH8x3503_CHANT_001-12a.13"/><seg xml:id="CH8x3503_CHANT_001-12a.14"><c n="…"/><c n="…"/>而守者不出<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.15"/><seg xml:id="CH8x3503_CHANT_001-12a.16">出者不守<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.17"/><seg xml:id="CH8x3503_CHANT_001-12a.18">守法<c n="："/></seg><seg xml:id="CH8x3503_CHANT_001-12a.19"/><seg xml:id="CH8x3503_CHANT_001-12a.20">丈<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.21"/><seg xml:id="CH8x3503_CHANT_001-12a.22">□人守<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.23"/><seg xml:id="CH8x3503_CHANT_001-12a.24">□</seg><seg xml:id="CH8x3503_CHANT_001-12a.25"/><seg xml:id="CH8x3503_CHANT_001-12a.26"><c n="…"/><c n="…"/>□一而當十<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.27"/><seg xml:id="CH8x3503_CHANT_001-12a.28">十而當百<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.29"/><seg xml:id="CH8x3503_CHANT_001-12a.30">百而當千萬<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.31"/><seg xml:id="CH8x3503_CHANT_001-12a.32"/><seg xml:id="CH8x3503_CHANT_001-12a.33"><c n="…"/><c n="…"/>城堅而厚<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.34"/><seg xml:id="CH8x3503_CHANT_001-12a.35">士民眾篡<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.36"/><seg xml:id="CH8x3503_CHANT_001-12a.37">薪食經</seg><seg xml:id="CH8x3503_CHANT_001-12a.38"/><seg xml:id="CH8x3503_CHANT_001-12a.39">□</seg><seg xml:id="CH8x3503_CHANT_001-12a.40">□勁矢仁<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.41"/><seg xml:id="CH8x3503_CHANT_001-12a.42">矛戟□□□</seg><seg xml:id="CH8x3503_CHANT_001-12a.43">□策也<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.44"/><seg xml:id="CH8x3503_CHANT_001-12a.45">攻者□□□□</seg><seg xml:id="CH8x3503_CHANT_001-12a.46">萬之眾乃稱<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.47"/><seg xml:id="CH8x3503_CHANT_001-12a.48">其有必救之軍<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.49"/><seg xml:id="CH8x3503_CHANT_001-12a.50">則有必</seg><seg xml:id="CH8x3503_CHANT_001-12a.51"/><seg xml:id="CH8x3503_CHANT_001-12a.52">□□□□</seg><seg xml:id="CH8x3503_CHANT_001-12a.53">必救之□<c n="…"/><c n="…"/>遇夫僮婦無不敝城盡資<c n="…"/><c n="…"/>則固不尚<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.54"/><seg xml:id="CH8x3503_CHANT_001-12a.55">鼓其藁桀俊雄<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.56"/><seg xml:id="CH8x3503_CHANT_001-12a.57">堅甲利兵勁弩仁矢并於前<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.58"/><seg xml:id="CH8x3503_CHANT_001-12a.59">則幼□毀□并於後<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.60"/><seg xml:id="CH8x3503_CHANT_001-12a.61">五萬之</seg><seg xml:id="CH8x3503_CHANT_001-12a.62"/><seg xml:id="CH8x3503_CHANT_001-12a.63">□□</seg><seg xml:id="CH8x3503_CHANT_001-12a.64">誠必救關之其後出要塞<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.65"/><seg xml:id="CH8x3503_CHANT_001-12a.66">担擊其後<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.67"/><seg xml:id="CH8x3503_CHANT_001-12a.68">毋通其量食<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.69"/><seg xml:id="CH8x3503_CHANT_001-12a.70">中外相應<c n="…"/><c n="…"/></seg><seg xml:id="CH8x3503_CHANT_001-12a.71"/><seg xml:id="CH8x3503_CHANT_001-12a.72"/><seg xml:id="CH8x3503_CHANT_001-12a.73"/></p>
            <p><seg xml:id="CH8x3503_CHANT_001-13a.1"/><seg xml:id="CH8x3503_CHANT_001-13a.2">四<c n="："/></seg><seg xml:id="CH8x3503_CHANT_001-13a.3"/></p>
            <p><seg xml:id="CH8x3503_CHANT_001-13a.4"/><seg xml:id="CH8x3503_CHANT_001-13a.5"><c n="…"/><c n="…"/>矢射之弗及<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.6"/><seg xml:id="CH8x3503_CHANT_001-13a.7">罷囚之請<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.8"/><seg xml:id="CH8x3503_CHANT_001-13a.9">不侍陳水楚□□□</seg><seg xml:id="CH8x3503_CHANT_001-13a.10">請可畢<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.11"/><seg xml:id="CH8x3503_CHANT_001-13a.12">其侍佰人之北<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.13"/><seg xml:id="CH8x3503_CHANT_001-13a.14">炤人之</seg><seg xml:id="CH8x3503_CHANT_001-13a.15"/><seg xml:id="CH8x3503_CHANT_001-13a.16">□□□□□</seg><seg xml:id="CH8x3503_CHANT_001-13a.17">以得囚請<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.18"/><seg xml:id="CH8x3503_CHANT_001-13a.19">則國士勝□<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.20"/><seg xml:id="CH8x3503_CHANT_001-13a.21">不宵自□<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.22"/><seg xml:id="CH8x3503_CHANT_001-13a.23">故今世千金不死<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.24"/><seg xml:id="CH8x3503_CHANT_001-13a.25">百金不胥靡<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.26"/><seg xml:id="CH8x3503_CHANT_001-13a.27">試聽臣之</seg><seg xml:id="CH8x3503_CHANT_001-13a.28"/><seg xml:id="CH8x3503_CHANT_001-13a.29"><c n="…"/><c n="…"/>知<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.30"/><seg xml:id="CH8x3503_CHANT_001-13a.31">不得關一言<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.32"/><seg xml:id="CH8x3503_CHANT_001-13a.33">□□□□□</seg><seg xml:id="CH8x3503_CHANT_001-13a.34">得用一朱<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.35"/><seg xml:id="CH8x3503_CHANT_001-13a.36">今夫𣪠者<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.37"/><seg xml:id="CH8x3503_CHANT_001-13a.38">小圉不下十數<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.39"/><seg xml:id="CH8x3503_CHANT_001-13a.40"/><seg xml:id="CH8x3503_CHANT_001-13a.41">□□□□</seg><seg xml:id="CH8x3503_CHANT_001-13a.42">百數<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.43"/><seg xml:id="CH8x3503_CHANT_001-13a.44">大圉不下千數<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.45"/><seg xml:id="CH8x3503_CHANT_001-13a.46">故一人</seg><seg xml:id="CH8x3503_CHANT_001-13a.47"/><seg xml:id="CH8x3503_CHANT_001-13a.48"><c n="…"/><c n="…"/>為不作<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.49"/><seg xml:id="CH8x3503_CHANT_001-13a.50">今夫𣪠者<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.51"/><seg xml:id="CH8x3503_CHANT_001-13a.52">大者父兄弟有在獄</seg><seg xml:id="CH8x3503_CHANT_001-13a.53"/><seg xml:id="CH8x3503_CHANT_001-13a.54" n="CH0F21DD"><c n="…"/><c n="…"/>離其<c n="&amp;"/><c n="-"/><c n=";"/>鄴<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.55"/><seg xml:id="CH8x3503_CHANT_001-13a.56" n="CH0F21DE">賈無不離其<c n="&amp;"/><c n="-"/><c n=";"/>宅<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.57"/><seg xml:id="CH8x3503_CHANT_001-13a.58">士大夫無不離其官府<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.59"/><seg xml:id="CH8x3503_CHANT_001-13a.60">□□</seg><seg xml:id="CH8x3503_CHANT_001-13a.61">□者<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.62"/><seg xml:id="CH8x3503_CHANT_001-13a.63">人之請也<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.64"/><seg xml:id="CH8x3503_CHANT_001-13a.65">故兵策曰<c n="："/></seg><seg xml:id="CH8x3503_CHANT_001-13a.66"/><seg xml:id="CH8x3503_CHANT_001-13a.67">十萬之</seg><seg xml:id="CH8x3503_CHANT_001-13a.68"/><seg xml:id="CH8x3503_CHANT_001-13a.69">師出<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.70"/><seg xml:id="CH8x3503_CHANT_001-13a.71">費日千金<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.72"/><seg xml:id="CH8x3503_CHANT_001-13a.73">今申戍十萬之眾<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.74"/><seg xml:id="CH8x3503_CHANT_001-13a.75">封內與天<c n="…"/><c n="…"/></seg><seg xml:id="CH8x3503_CHANT_001-13a.76"/><seg xml:id="CH8x3503_CHANT_001-13a.77"/><seg xml:id="CH8x3503_CHANT_001-13a.78"/></p>
            <p><seg xml:id="CH8x3503_CHANT_001-14a.1"/><seg xml:id="CH8x3503_CHANT_001-14a.2">五<c n="："/></seg><seg xml:id="CH8x3503_CHANT_001-14a.3"/></p>
            <p><seg xml:id="CH8x3503_CHANT_001-14a.4"/><seg xml:id="CH8x3503_CHANT_001-14a.5"><c n="…"/><c n="…"/>償尊參會<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.6"/><seg xml:id="CH8x3503_CHANT_001-14a.7">移民之具也<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.8"/><seg xml:id="CH8x3503_CHANT_001-14a.9"><c n="‧"/>均地分<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.10"/><seg xml:id="CH8x3503_CHANT_001-14a.11">節傅斂<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.12"/><seg xml:id="CH8x3503_CHANT_001-14a.13">□</seg><seg xml:id="CH8x3503_CHANT_001-14a.14"/><seg xml:id="CH8x3503_CHANT_001-14a.15"><c n="…"/><c n="…"/>□臣主根也<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.16"/><seg xml:id="CH8x3503_CHANT_001-14a.17"><c n="‧"/>刑賞明省<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.18"/><seg xml:id="CH8x3503_CHANT_001-14a.19">畏誅重姦<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.20"/><seg xml:id="CH8x3503_CHANT_001-14a.21">止姦<c n="…"/><c n="…"/>原<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.22"/><seg xml:id="CH8x3503_CHANT_001-14a.23">正事之均也<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.24"/><seg xml:id="CH8x3503_CHANT_001-14a.25"/><seg xml:id="CH8x3503_CHANT_001-14a.26"><c n="…"/><c n="…"/>王之二術也<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.27"/><seg xml:id="CH8x3503_CHANT_001-14a.28"><c n="‧"/>柤豆同利制天下</seg><seg xml:id="CH8x3503_CHANT_001-14a.29"/><seg xml:id="CH8x3503_CHANT_001-14a.30"><c n="…"/><c n="…"/>王者之德也<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.31"/><seg xml:id="CH8x3503_CHANT_001-14a.32"><c n="‧"/>明禮常<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.33"/><seg xml:id="CH8x3503_CHANT_001-14a.34">䩗者之</seg><seg xml:id="CH8x3503_CHANT_001-14a.35"/><seg xml:id="CH8x3503_CHANT_001-14a.36"><c n="…"/><c n="…"/>无事□<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.37"/><seg xml:id="CH8x3503_CHANT_001-14a.38">上无慶賞<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.39"/><seg xml:id="CH8x3503_CHANT_001-14a.40">民无獄訟<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.41"/><seg xml:id="CH8x3503_CHANT_001-14a.42">國无商賈<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.43"/><seg xml:id="CH8x3503_CHANT_001-14a.44">成王至正也<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.45"/><seg xml:id="CH8x3503_CHANT_001-14a.46"><c n="‧"/>服奉下迵<c n="，"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.47"/><seg xml:id="CH8x3503_CHANT_001-14a.48">成王至德也<c n="。"/></seg><seg xml:id="CH8x3503_CHANT_001-14a.49"/></p>
         </div>
