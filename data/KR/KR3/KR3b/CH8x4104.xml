   <text>
      <body>
         <div>
                
<head xml:id="CH8x4104_CHANT_001-1a.1-h-h"><seg xml:id="CH8x4104_CHANT_001-1a.1-h">竹簡篇題</seg></head>
            <p><seg xml:id="CH8x4104_CHANT_001-1a.1"/><seg xml:id="CH8x4104_CHANT_001-1a.2">□賢而不知賢仁第四</seg><seg xml:id="CH8x4104_CHANT_001-1a.3">方治國之道第六</seg><seg xml:id="CH8x4104_CHANT_001-1a.4" n="．．">亂之要第七吏十重罪民十</seg><seg xml:id="CH8x4104_CHANT_001-1a.5">□□□國所貴第八</seg><seg xml:id="CH8x4104_CHANT_001-1a.6">方以禮義為國第十</seg><seg xml:id="CH8x4104_CHANT_001-1a.7">□第十二</seg><seg xml:id="CH8x4104_CHANT_001-1a.8">第十三</seg><seg xml:id="CH8x4104_CHANT_001-1a.9">舜伐有苗武</seg><seg xml:id="CH8x4104_CHANT_001-1a.10">□大失第十四</seg><seg xml:id="CH8x4104_CHANT_001-1a.11">方武王勝殷第十六</seg><seg xml:id="CH8x4104_CHANT_001-1a.12">□歸廿二</seg><seg xml:id="CH8x4104_CHANT_001-1a.13" n="．">幼弱第廿</seg><seg xml:id="CH8x4104_CHANT_001-1a.14">右方國有八禁第卅</seg><seg xml:id="CH8x4104_CHANT_001-1a.15">第卅一</seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4104_CHANT_002-1a.1-h-h"><seg xml:id="CH8x4104_CHANT_002-1a.1-h">《文韜．國務》</seg></head>
            <p><seg xml:id="CH8x4104_CHANT_002-1a.1"/><seg xml:id="CH8x4104_CHANT_002-1a.2"><c n="※"/></seg></p>
            <p><seg xml:id="CH8x4104_CHANT_002-1a.3">曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_002-1a.4">為國之務果何<c n="？"/></seg><seg xml:id="CH8x4104_CHANT_002-1a.5">太公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_002-1a.6">失其所務<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_002-1a.7">是胃害之<c n="；"/></seg><seg xml:id="CH8x4104_CHANT_002-1a.8">農失其時<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_002-1a.9">是胃□</seg><seg xml:id="CH8x4104_CHANT_002-1a.10">□殺之<c n="；"/></seg><seg xml:id="CH8x4104_CHANT_002-1a.11">重賦□</seg><seg xml:id="CH8x4104_CHANT_002-1a.12">□是胃奪之<c n="；"/></seg><seg xml:id="CH8x4104_CHANT_002-1a.13">多治台游宮室之觀<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_002-1a.14">而不</seg><seg xml:id="CH8x4104_CHANT_002-1a.15">者其民□<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_002-1a.16">是胃苦之<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_002-1a.17">□□而□</seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4104_CHANT_003-1a.1-h-h"><seg xml:id="CH8x4104_CHANT_003-1a.1-h">《文韜．舉賢》</seg></head>
            <p><seg xml:id="CH8x4104_CHANT_003-1a.1"/><seg xml:id="CH8x4104_CHANT_003-1a.2"><c n="※"/></seg></p>
            <p><seg xml:id="CH8x4104_CHANT_003-1a.3">文王問太公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_003-1a.4">舉賢而國危亡者何也<c n="？"/></seg><seg xml:id="CH8x4104_CHANT_003-1a.5">太公</seg><seg xml:id="CH8x4104_CHANT_003-1a.6">賢之實</seg><seg xml:id="CH8x4104_CHANT_003-1a.7">□好用以善<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_003-1a.8">而以故不得<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_003-1a.9">□不忠</seg><seg xml:id="CH8x4104_CHANT_003-1a.10">為忠<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_003-1a.11">以非信為信<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_003-1a.12">以譽為功<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_003-1a.13">以□</seg><seg xml:id="CH8x4104_CHANT_003-1a.14">黨者<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_003-1a.15">是其群至比周□習□也<c n="。"/></seg><seg xml:id="CH8x4104_CHANT_003-1a.16">□而忠臣死於無罪<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_003-1a.17">其邪臣以</seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4104_CHANT_004-1a.1-h-h"><seg xml:id="CH8x4104_CHANT_004-1a.1-h">《龍韜．農器》</seg></head>
            <p><seg xml:id="CH8x4104_CHANT_004-1a.1"/><seg xml:id="CH8x4104_CHANT_004-1a.2"><c n="※"/></seg></p>
            <p><seg xml:id="CH8x4104_CHANT_004-1a.3">問大公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_004-1a.4"><c n="「"/>天下大定<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_004-1a.5">國家毋</seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4104_CHANT_005-1a.1-h-h"><seg xml:id="CH8x4104_CHANT_005-1a.1-h">《利人》</seg></head>
            <p><seg xml:id="CH8x4104_CHANT_005-1a.1"/><seg xml:id="CH8x4104_CHANT_005-1a.2"><c n="※"/></seg></p>
            <p><seg xml:id="CH8x4104_CHANT_005-1a.3">之必行也<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_005-1a.4">必行者民利<c n="。"/></seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4104_CHANT_006-1a.1-h-h"><seg xml:id="CH8x4104_CHANT_006-1a.1-h">《趨舍》</seg></head>
            <p><seg xml:id="CH8x4104_CHANT_006-1a.1"/><seg xml:id="CH8x4104_CHANT_006-1a.2"><c n="※"/></seg></p>
            <p><seg xml:id="CH8x4104_CHANT_006-1a.3">不同<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_006-1a.4">喜怒不等<c n="。"/></seg><seg xml:id="CH8x4104_CHANT_006-1a.5">故有舊之□<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_006-1a.6">有</seg><seg xml:id="CH8x4104_CHANT_006-1a.7">安樂<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_006-1a.8">君世世有國<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_006-1a.9">合於忠者<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_006-1a.10">賢士臣</seg><seg xml:id="CH8x4104_CHANT_006-1a.11">令遠者來<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_006-1a.12">合</seg><seg xml:id="CH8x4104_CHANT_006-1a.13">治<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_006-1a.14">而民不比<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_006-1a.15">合於貪者<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_006-1a.16">民</seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4104_CHANT_007-1a.1-h-h"><seg xml:id="CH8x4104_CHANT_007-1a.1-h">《禮儀》</seg></head>
            <p><seg xml:id="CH8x4104_CHANT_007-1a.1"/><seg xml:id="CH8x4104_CHANT_007-1a.2"><c n="※"/></seg></p>
            <p><seg xml:id="CH8x4104_CHANT_007-1a.3">咸以禮儀為國<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_007-1a.4">而不能</seg><seg xml:id="CH8x4104_CHANT_007-1a.5">者何也<c n="？"/></seg><seg xml:id="CH8x4104_CHANT_007-1a.6">大公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_007-1a.7">禮者</seg><seg xml:id="CH8x4104_CHANT_007-1a.8">為國不用禮儀可</seg><seg xml:id="CH8x4104_CHANT_007-1a.9">之分擇也<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_007-1a.10">非所以□□</seg><seg xml:id="CH8x4104_CHANT_007-1a.11">禮儀之為國也<c n="。"/></seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4104_CHANT_008-1a.1-h-h"><seg xml:id="CH8x4104_CHANT_008-1a.1-h">《大失》</seg></head>
            <p><seg xml:id="CH8x4104_CHANT_008-1a.1"/><seg xml:id="CH8x4104_CHANT_008-1a.2"><c n="※"/></seg></p>
            <p><seg xml:id="CH8x4104_CHANT_008-1a.3">□<c n="；"/></seg><seg xml:id="CH8x4104_CHANT_008-1a.4">不法邪不亡<c n="；"/></seg><seg xml:id="CH8x4104_CHANT_008-1a.5">不法禍日起<c n="；"/></seg><seg xml:id="CH8x4104_CHANT_008-1a.6">不□</seg><seg xml:id="CH8x4104_CHANT_008-1a.7">□亡□<c n="；"/></seg><seg xml:id="CH8x4104_CHANT_008-1a.8">不法國且亂<c n="；"/></seg><seg xml:id="CH8x4104_CHANT_008-1a.9">不法民多□</seg><seg xml:id="CH8x4104_CHANT_008-1a.10">旱至<c n="；"/></seg><seg xml:id="CH8x4104_CHANT_008-1a.11">不法</seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4104_CHANT_009-1a.1-h-h"><seg xml:id="CH8x4104_CHANT_009-1a.1-h">《動應》</seg></head>
            <p><seg xml:id="CH8x4104_CHANT_009-1a.1"/><seg xml:id="CH8x4104_CHANT_009-1a.2"><c n="※"/></seg></p>
            <p><seg xml:id="CH8x4104_CHANT_009-1a.3">□五□不就<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_009-1a.4">□□</seg><seg xml:id="CH8x4104_CHANT_009-1a.5">□應其聲也<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_009-1a.6">如景之象其刑也<c n="。"/></seg></p>
         </div>
         <div>
                
<head xml:id="CH8x4104_CHANT_010-1a.1-h-h"><seg xml:id="CH8x4104_CHANT_010-1a.1-h">《六韜逸文》</seg></head>
            <p><seg xml:id="CH8x4104_CHANT_010-1a.1"/><seg xml:id="CH8x4104_CHANT_010-1a.2"><c n="※"/></seg></p>
            <p><seg xml:id="CH8x4104_CHANT_010-1a.3">□人父<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.4">孤人</seg><seg xml:id="CH8x4104_CHANT_010-1a.5">忠諫者死<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.6">臾誢者賞<c n="。"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.7">以君子為下<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.8">以小人為</seg><seg xml:id="CH8x4104_CHANT_010-1a.9">馬<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.10">出入不以時</seg><seg xml:id="CH8x4104_CHANT_010-1a.11">□風□甚雨<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.12">寒暑喜治宮室台池<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.13">日□</seg><seg xml:id="CH8x4104_CHANT_010-1a.14">日夜久□□□</seg><seg xml:id="CH8x4104_CHANT_010-1a.15">□七十三所<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.16">大宮</seg><seg xml:id="CH8x4104_CHANT_010-1a.17">王般庚之正<c n="。"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.18">武王曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.19">于呼般</seg><seg xml:id="CH8x4104_CHANT_010-1a.20">曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.21"><c n="「"/>禮賢敬士□</seg><seg xml:id="CH8x4104_CHANT_010-1a.22">聽<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.23">獨斷<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.24">而</seg><seg xml:id="CH8x4104_CHANT_010-1a.25">言凡不□</seg><seg xml:id="CH8x4104_CHANT_010-1a.26">凡治國<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.27">主務舉賢<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.28">故昔者湯之治</seg><seg xml:id="CH8x4104_CHANT_010-1a.29">曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.30"><c n="「"/>奈何<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.31">大公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.32"><c n="「"/>法令通□而□□<c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.33">未足以大利其民者也<c n="。"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.34">是以法令利民之</seg><seg xml:id="CH8x4104_CHANT_010-1a.35" n="......"/><seg xml:id="CH8x4104_CHANT_010-1a.36">問太公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.37"><c n="「"/>為國而能更法令者　</seg><seg xml:id="CH8x4104_CHANT_010-1a.38">曰章矣</seg><seg xml:id="CH8x4104_CHANT_010-1a.39">塞奸不得<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.40">上下惑<c n="。"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.41">不法□</seg><seg xml:id="CH8x4104_CHANT_010-1a.42">草木不羊<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.43">日月傳蝕<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.44">列星數</seg><seg xml:id="CH8x4104_CHANT_010-1a.45">之□乎<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.46">對曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.47"><c n="「"/>未有日月斷蝕<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.48">有始</seg><seg xml:id="CH8x4104_CHANT_010-1a.49">□以歡為□□</seg><seg xml:id="CH8x4104_CHANT_010-1a.50">喜□不予<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.51">而喜奪此妾為正<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.52">臣虜明□</seg><seg xml:id="CH8x4104_CHANT_010-1a.53">貴胥餘<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.54">大宮室<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.55">舊以復多</seg><seg xml:id="CH8x4104_CHANT_010-1a.56">熊狼<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.57">月食□</seg><seg xml:id="CH8x4104_CHANT_010-1a.58">□曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.59">吾聞有苗雨沾血朝衣<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.60">是非有苗</seg><seg xml:id="CH8x4104_CHANT_010-1a.61">有苗月蝕日斷<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.62">三日不解<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.63">是非□</seg><seg xml:id="CH8x4104_CHANT_010-1a.64">有苗三日不見日<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.65">是非有苗之□耶<c n="？"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.66">對</seg><seg xml:id="CH8x4104_CHANT_010-1a.67">□曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.68"><c n="「"/>然則有苗何以亡<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.69">對曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.70"><c n="「"/>有</seg><seg xml:id="CH8x4104_CHANT_010-1a.71">之□右□蠡之水建土險也</seg><seg xml:id="CH8x4104_CHANT_010-1a.72">有苗是謂所</seg><seg xml:id="CH8x4104_CHANT_010-1a.73">□□□之□也<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.74">一曰君</seg><seg xml:id="CH8x4104_CHANT_010-1a.75">而害其國<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.76">二曰臣移者</seg><seg xml:id="CH8x4104_CHANT_010-1a.77">害其君<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.78">三</seg><seg xml:id="CH8x4104_CHANT_010-1a.79">大者害其本<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.80">四曰枝盛者</seg><seg xml:id="CH8x4104_CHANT_010-1a.81">五</seg><seg xml:id="CH8x4104_CHANT_010-1a.82">者害其□</seg><seg xml:id="CH8x4104_CHANT_010-1a.83">□八曰□□</seg><seg xml:id="CH8x4104_CHANT_010-1a.84">□□□曰□</seg><seg xml:id="CH8x4104_CHANT_010-1a.85">王問太公<c n="「"/>治亂奈何<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.86">太公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.87"><c n="「"/>其本<c n="。"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.88">武王曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.89"><c n="「"/>為吏治也□□安在<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.90">太</seg><seg xml:id="CH8x4104_CHANT_010-1a.91">吏者重能</seg><seg xml:id="CH8x4104_CHANT_010-1a.92">者□之□□也<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.93">□者吏之□□也□</seg><seg xml:id="CH8x4104_CHANT_010-1a.94">乃失其國</seg><seg xml:id="CH8x4104_CHANT_010-1a.95">曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.96"><c n="「"/>□吏之□觀民之□奈何乎<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.97">太公</seg><seg xml:id="CH8x4104_CHANT_010-1a.98">吏□任<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.99">吏與民通<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.100">吏與民謂合<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.101">吏</seg><seg xml:id="CH8x4104_CHANT_010-1a.102">吏□□可以</seg><seg xml:id="CH8x4104_CHANT_010-1a.103">吏毋奸<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.104">段段而眾人於□</seg><seg xml:id="CH8x4104_CHANT_010-1a.105">□土者臣吏也<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.106">快志當</seg><seg xml:id="CH8x4104_CHANT_010-1a.107">曰□□吏公</seg><seg xml:id="CH8x4104_CHANT_010-1a.108">上好淫□</seg><seg xml:id="CH8x4104_CHANT_010-1a.109">□鬼不鄉<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.110">天必降央<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.111">風雨不時<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.112">□□不□</seg><seg xml:id="CH8x4104_CHANT_010-1a.113">之治國<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.114">敢問□</seg><seg xml:id="CH8x4104_CHANT_010-1a.115">所泥<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.116">不用所愛<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.117">不用</seg><seg xml:id="CH8x4104_CHANT_010-1a.118">武王問太公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.119"><c n="「"/>王君之治國何如乎<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.120">太公</seg><seg xml:id="CH8x4104_CHANT_010-1a.121">重賦斂奪萬民<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.122">而腐之於府庫<c n="。"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.123">所</seg><seg xml:id="CH8x4104_CHANT_010-1a.124">□康<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.125">不得聲嚴<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.126">而行賢者反佻伏</seg><seg xml:id="CH8x4104_CHANT_010-1a.127">其君不更不誨<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.128">使下人任大官而□</seg><seg xml:id="CH8x4104_CHANT_010-1a.129">亡<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.130">比君之治國也<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.131">□翼之臣<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.132">所</seg><seg xml:id="CH8x4104_CHANT_010-1a.133">臣有羽翼</seg><seg xml:id="CH8x4104_CHANT_010-1a.134">之□比為腹心之臣<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.135">王不事而不□</seg><seg xml:id="CH8x4104_CHANT_010-1a.136">四曰義<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.137">五曰權<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.138">六</seg><seg xml:id="CH8x4104_CHANT_010-1a.139">□其權<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.140">守其德<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.141">不以蕩人□<c n="。"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.142" n="．">故王人之</seg><seg xml:id="CH8x4104_CHANT_010-1a.143">厚其祿<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.144">毋親毋故<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.145">吏貞而平者上之不</seg><seg xml:id="CH8x4104_CHANT_010-1a.146">□者表其閭<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.147">君自至其家<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.148">君唯有善有□</seg><seg xml:id="CH8x4104_CHANT_010-1a.149">質子於殷<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.150">周文王使伯邑巧</seg><seg xml:id="CH8x4104_CHANT_010-1a.151">死<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.152">有詔必王食其肉<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.153">□免其血<c n="。"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.154">文王食其肉<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.155">□免其</seg><seg xml:id="CH8x4104_CHANT_010-1a.156">大公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.157"><c n="「"/>人</seg><seg xml:id="CH8x4104_CHANT_010-1a.158">聞其窮也<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.159">恒人之請<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.160">其所好惡同也<c n="。"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.161">□昔親合在真者<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.162">貞者急而刑使國□</seg><seg xml:id="CH8x4104_CHANT_010-1a.163">王問太公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.164"><c n="「"/>吾勝殷□呼<c n="？"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.165">胡為胡□□<c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.166">陽殷<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.167">問太公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.168"><c n="「"/>於乎殷民從從□□<c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.169">為在建國立國□</seg><seg xml:id="CH8x4104_CHANT_010-1a.170">事者用明知<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.171">工疑者</seg><seg xml:id="CH8x4104_CHANT_010-1a.172">而御之則焉辟應去猶知</seg><seg xml:id="CH8x4104_CHANT_010-1a.173">曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.174"><c n="「"/>二也<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.175">波王良之御也<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.176">使</seg><seg xml:id="CH8x4104_CHANT_010-1a.177">民乎<c n="！"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.178">故民心一也<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.179">有道者□之則</seg><seg xml:id="CH8x4104_CHANT_010-1a.180">馬也<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.181">馬心一也<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.182">有術者御之<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.183">則馬正</seg><seg xml:id="CH8x4104_CHANT_010-1a.184">□取其國不得<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.185">免於危亡<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.186">武王</seg><seg xml:id="CH8x4104_CHANT_010-1a.187">□曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.188"><c n="「"/>□以別能<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.189">大公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.190"><c n="「"/>厪之以名□癘</seg><seg xml:id="CH8x4104_CHANT_010-1a.191">能武王曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.192"><c n="「"/>何以</seg><seg xml:id="CH8x4104_CHANT_010-1a.193"><c n="「"/>遠者毋法<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.194">為之奈何<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.195">大公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.196"><c n="「"/>□刑利國□<c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.197">問太公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.198"><c n="「"/>為國□□□□□□□<c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.199">文王召大公</seg><seg xml:id="CH8x4104_CHANT_010-1a.200"><c n="「"/>□之乏乎<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.201">大公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.202">下□<c n="。"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.203">武王曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.204"><c n="「"/>何謂<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.205">大公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.206">也<c n="。"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.207">武王曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.208"><c n="「"/>其□□□□<c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.209">□而何<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.210">大公</seg><seg xml:id="CH8x4104_CHANT_010-1a.211">大公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.212"><c n="「"/>正不平<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.213">民不令<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.214">其令不行<c n="。"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.215">如□<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.216">文王大警走門□□至□□□□□</seg><seg xml:id="CH8x4104_CHANT_010-1a.217">□之士<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.218">拾君之□<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.219">揚君之善美<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.220">養君之</seg><seg xml:id="CH8x4104_CHANT_010-1a.221">其民甚苦之毋所</seg><seg xml:id="CH8x4104_CHANT_010-1a.222">使誠為事以功<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.223">擊為作禍福<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.224">不可</seg><seg xml:id="CH8x4104_CHANT_010-1a.225">有王<c n="。"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.226">大公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.227"><c n="「"/>人有仁</seg><seg xml:id="CH8x4104_CHANT_010-1a.228">武王曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.229"><c n="「"/>何謂</seg><seg xml:id="CH8x4104_CHANT_010-1a.230">大公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.231"><c n="「"/>上大夫皆得取其官爵<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.232">莫不</seg><seg xml:id="CH8x4104_CHANT_010-1a.233">乎<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.234">武王曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.235"><c n="「"/>為之奈何<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.236">大公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.237"><c n="「"/>□上</seg><seg xml:id="CH8x4104_CHANT_010-1a.238"><c n="「"/>□果何如而政<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.239">何如而頃<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.240">大公曰</seg><seg xml:id="CH8x4104_CHANT_010-1a.241"><c n="「"/>□□安在<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.242">大公曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.243"><c n="「"/>安不</seg><seg xml:id="CH8x4104_CHANT_010-1a.244"><c n="「"/>奈何<c n="？"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.245">大</seg><seg xml:id="CH8x4104_CHANT_010-1a.246">靡草如□</seg><seg xml:id="CH8x4104_CHANT_010-1a.247">貴□□人而以為善者<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.248">故其民□</seg><seg xml:id="CH8x4104_CHANT_010-1a.249"><c n="「"/>善而不為惡矣<c n="。"/><c n="」"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.250">武王曰<c n="："/></seg><seg xml:id="CH8x4104_CHANT_010-1a.251"><c n="「"/>分善惡奈何<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.252">□眾□□</seg><seg xml:id="CH8x4104_CHANT_010-1a.253">已故為國能知分善惡之分</seg><seg xml:id="CH8x4104_CHANT_010-1a.254">官以治為常<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.255">三曰士以修身為常<c n="，"/></seg><seg xml:id="CH8x4104_CHANT_010-1a.256">四曰</seg></p>
         </div>
      </body>
   </text>
</TEI>